# Backend Configuration
PORT=5000
NODE_ENV=development
JWT_SECRET=your_super_secure_jwt_secret_key_change_in_production_12345
ADMIN_PASSWORD=change_this_admin_dashboard_password
ENCRYPTION_KEY=your_32_char_encryption_key_here_

# ── DynamoDB Configuration ────────────────────────────────────────────────────
# Local development (DynamoDB Local in Docker)
DYNAMODB_ENDPOINT=http://localhost:8000

# AWS credentials — use dummy values for local dev; real credentials for AWS
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local

# ── AWS Deployment (unset DYNAMODB_ENDPOINT and fill in real creds) ───────────
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=AKIA...
# AWS_SECRET_ACCESS_KEY=...

# Frontend Configuration
VITE_API_URL=http://localhost:5000

# ── Mobile (Capacitor Android / iOS) ─────────────────────────────────────────
# Set this to your DEPLOYED backend's public URL so the native WebView
# can reach the server (it cannot use localhost).
# Example: VITE_API_URL_NATIVE=https://your-backend.railway.app
VITE_API_URL_NATIVE=

# Allowed CORS origin for the native WebView (used by backend).
# Capacitor Android uses "https://localhost" as its origin by default.
# Example: CLIENT_URL=http://localhost:5173,https://localhost,capacitor://localhost
CLIENT_URL=http://localhost:5173
