# Backend Configuration
PORT=5001
NODE_ENV=development
JWT_SECRET=your_super_secure_jwt_secret_key_change_in_production_12345
ADMIN_PASSWORD=change_this_admin_dashboard_password
ENCRYPTION_KEY=your_32_char_encryption_key_here_

# ── DynamoDB Configuration ────────────────────────────────────────────────────
# Local development (DynamoDB Local in Docker)
DYNAMODB_ENDPOINT=http://localhost:8000

# AWS credentials — use dummy values for local dev; real credentials for AWS
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local

# ── AWS Deployment (unset DYNAMODB_ENDPOINT and fill in real creds) ───────────
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=AKIA...
# AWS_SECRET_ACCESS_KEY=...

# Frontend Configuration
VITE_API_URL=http://localhost:5000

# ── Mobile (Capacitor Android / iOS) ─────────────────────────────────────────
# Set this to your DEPLOYED backend's public URL so the native WebView
# can reach the server (it cannot use localhost).
# Example: VITE_API_URL_NATIVE=https://your-backend.railway.app
VITE_API_URL_NATIVE=

# Allowed CORS origin for the native WebView (used by backend).
# Capacitor Android uses "https://localhost" as its origin by default.
# Example: CLIENT_URL=http://localhost:5173,https://localhost,capacitor://localhost
CLIENT_URL=http://localhost:5173

# ── MinIO / S3-compatible storage (Learning German images) ────────────────────
# Store images in MinIO (local) or AWS S3 (production).
# For local Docker MinIO: STORAGE_ENDPOINT=http://minio:9000
# For local dev without Docker: STORAGE_ENDPOINT=http://localhost:9000
# For AWS S3: STORAGE_ENDPOINT=https://s3.amazonaws.com (or your region-specific endpoint)
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_ACCESS_KEY=admin
STORAGE_SECRET_KEY=password123
STORAGE_BUCKET=learning-german-images
STORAGE_REGION=us-east-1
USE_PATH_STYLE=true

# AWS S3 production example (uncomment and fill in):
# STORAGE_ENDPOINT=https://s3.us-east-1.amazonaws.com
# STORAGE_ACCESS_KEY=AKIA...
# STORAGE_SECRET_KEY=...
# STORAGE_BUCKET=my-german-images
# STORAGE_REGION=us-east-1
# USE_PATH_STYLE=false
