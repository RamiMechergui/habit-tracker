# Backend Configuration
PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://mongo:27017/habittracker
# Backend Configuration
PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://mongo:27017/habittracker
JWT_SECRET=your_super_secure_jwt_secret_key_change_in_production_12345
ADMIN_PASSWORD=change_this_admin_dashboard_password

# Frontend Configuration
VITE_API_URL=http://localhost:5000/api

# ── Mobile (Capacitor Android / iOS) ────────────────────────────────────────
# Set this to your DEPLOYED backend's public URL so the native WebView
# can reach the server (it cannot use localhost).
# Example: VITE_API_URL_NATIVE=https://your-backend.railway.app
VITE_API_URL_NATIVE=

# Allowed CORS origin for the native WebView (used by backend microservices).
# Capacitor Android uses "https://localhost" as its origin by default.
# Example: CLIENT_URL=http://localhost:5173,https://localhost,capacitor://localhost
CLIENT_URL=http://localhost:5173

# Mongo Express Configuration
ME_CONFIG_MONGODB_SERVER=mongo
ME_CONFIG_MONGODB_PORT=27017
ME_CONFIG_BASICAUTH_USERNAME=admin
ME_CONFIG_BASICAUTH_PASSWORD=changeme_in_production

# Railway MongoDB Configuration
MONGO_URL=${{ MongoDB.MONGO_URL }}
MONGOHOST=${{ MongoDB.MONGOHOST }}
MONGOPORT=${{ MongoDB.MONGOPORT }}
MONGOUSER=${{ MongoDB.MONGOUSER }}
MONGOPASSWORD=${{ MongoDB.MONGOPASSWORD }}
